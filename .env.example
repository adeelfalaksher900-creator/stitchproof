# The AI reader needs ONE of these. Without either, Stitchproof still proofs
# standard patterns offline; only free-form prose can't be read.

# Option A — Google Gemini (free tier, no card): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Option B — Vercel AI Gateway. On Vercel the deployment's OIDC token is used
# automatically (the team needs a card on file to unlock free credits).
# Locally, set a gateway key:
AI_GATEWAY_API_KEY=

# Optional: override the model used by the AI reader.
# STITCHPROOF_MODEL=anthropic/claude-haiku-5.5

# Optional: used for canonical URLs and the GitHub link.
# NEXT_PUBLIC_SITE_URL=https://stitchproof-alpha.vercel.app
# NEXT_PUBLIC_REPO_URL=https://github.com/adeelfalaksher900-creator/stitchproof
